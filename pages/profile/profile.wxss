.member-card { margin: 24rpx 0 40rpx; min-height: 124rpx; padding: 26rpx; display: flex; align-items: center; justify-content: space-between; }.member-card > view { display: flex; flex-direction: column; }.member-title { font-size: 29rpx; font-weight: 600; }.member-desc { color: var(--muted); font-size: 22rpx; margin-top: 12rpx; }.member-arrow { color: var(--muted); font-size: 40rpx; }.settings-title { font-size: 27rpx; font-weight: 600; margin: 0 0 16rpx; }.settings-card { padding: 0 26rpx; margin-bottom: 36rpx; }.setting-row { display: flex; align-items: center; min-height: 122rpx; border-bottom: 2rpx solid var(--line); }.setting-row:last-child { border: 0; }.setting-copy { display: flex; flex: 1; flex-direction: column; }.setting-copy text:first-child { font-size: 28rpx; font-weight: 500; }.setting-copy text:last-child { color: var(--muted); font-size: 22rpx; margin-top: 9rpx; }.setting-row switch { transform: scale(.85); transform-origin: right center; }.time-picker { font-size: 27rpx; color: var(--ink); }.time-picker text { color: var(--muted); margin-left: 14rpx; }.link-row { width: 100%; height: 104rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 2rpx solid var(--line); background: transparent; font-size: 27rpx; text-align: left; }.link-row:last-child { border: 0; }.link-row text:last-child { color: var(--muted); font-size: 38rpx; }
