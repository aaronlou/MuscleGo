.brand { font-size: 30rpx; font-weight: 700; }.streak-mini { font-size: 23rpx; color: var(--muted); }
.welcome { margin: 34rpx 0 30rpx; }.welcome-date { color: var(--muted); font-size: 24rpx; }.welcome-title { margin-top: 14rpx; font-size: 38rpx; font-weight: 600; }
.hero { padding: 32rpx; border-radius: 24rpx; background: var(--ink); color: #fff; }.hero-label { color: #d4dfd9; font-size: 23rpx; }.hero-title { margin-top: 20rpx; font-size: 42rpx; font-weight: 600; }.hero-meta { display: flex; gap: 28rpx; margin: 22rpx 0 30rpx; color: #d4dfd9; font-size: 24rpx; }.start-btn { height: 92rpx; width: 100%; padding: 0 28rpx; display: flex; justify-content: space-between; align-items: center; border-radius: 16rpx; background: #fff; color: var(--ink); font-size: 30rpx; font-weight: 600; }.done-note { margin-top: 20rpx; text-align: center; color: #d4dfd9; font-size: 23rpx; }
.week-section { margin-top: 40rpx; }.section-head { display: flex; align-items: center; justify-content: space-between; }.section-title { font-size: 30rpx; font-weight: 600; }.week-row { display: flex; justify-content: space-between; margin-top: 22rpx; }.day-cell { display: flex; flex-direction: column; align-items: center; gap: 14rpx; }.day-label { color: var(--muted); font-size: 21rpx; }.day-dot { width: 58rpx; height: 58rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; color: #7b837d; font-size: 23rpx; border: 2rpx solid #dce1db; }.day-cell.today .day-dot { border: 3rpx solid var(--ink); }.day-cell.today .day-label { color: var(--ink); font-weight: 600; }.day-dot.checked { background: var(--ink); color: white; border-color: var(--ink); }
.exercise-head { margin: 44rpx 0 20rpx; }.exercise-list { display: flex; flex-direction: column; gap: 14rpx; }.exercise-card { display: flex; align-items: center; min-height: 116rpx; padding: 20rpx 24rpx; }.exercise-order { width: 56rpx; height: 56rpx; flex-shrink: 0; border-radius: 12rpx; background: #edf0eb; display: flex; align-items: center; justify-content: center; font-size: 24rpx; }.exercise-info { display: flex; flex-direction: column; margin-left: 22rpx; }.exercise-name { font-size: 29rpx; font-weight: 600; }.exercise-part { margin-top: 10rpx; color: var(--muted); font-size: 23rpx; }.exercise-go { margin-left: auto; color: #969e98; font-size: 40rpx; }
.kind-note { margin-top: 30rpx; color: var(--muted); font-size: 22rpx; line-height: 1.7; }
