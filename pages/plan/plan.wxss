.page { padding-bottom: 160rpx; }.plan-duration { color: var(--muted); font-size: 22rpx; }.day-picker { display: flex; justify-content: space-between; gap: 10rpx; margin: 24rpx 0 28rpx; }.day-option { width: 82rpx; height: 96rpx; flex-shrink: 0; border: 2rpx solid var(--line); border-radius: 14rpx; background: #fff; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8rpx; color: var(--muted); }.day-option.selected { color: #fff; background: var(--ink); border-color: var(--ink); }.day-week { font-size: 20rpx; }.day-focus { font-size: 22rpx; }
.plan-summary { padding: 28rpx; display: flex; align-items: center; justify-content: space-between; }.plan-week { color: var(--muted); font-size: 22rpx; }.plan-name { margin-top: 12rpx; font-size: 34rpx; font-weight: 600; }.plan-sub { display: block; margin-top: 12rpx; color: var(--muted); font-size: 22rpx; }.time-stamp { display: flex; align-items: baseline; gap: 6rpx; color: var(--muted); font-size: 21rpx; }.time-number { color: var(--ink); font-size: 46rpx; font-weight: 600; }.section-label { display: flex; justify-content: space-between; align-items: center; margin: 36rpx 0 18rpx; font-size: 28rpx; font-weight: 600; }.section-label .muted { font-size: 21rpx; font-weight: 400; }.plan-list { display: flex; flex-direction: column; gap: 14rpx; }.plan-exercise { padding: 0 24rpx; }.exercise-row { min-height: 116rpx; display: flex; align-items: center; }.order { width: 54rpx; color: var(--muted); font-size: 24rpx; }.exercise-main { display: flex; flex: 1; flex-direction: column; }.exercise-title { font-size: 29rpx; font-weight: 600; }.exercise-desc { margin-top: 10rpx; font-size: 22rpx; color: var(--muted); }.expand { font-size: 38rpx; color: var(--muted); }.exercise-detail { padding-bottom: 26rpx; }.detail-line { height: 2rpx; background: var(--line); margin-bottom: 22rpx; }.cue { display: flex; gap: 12rpx; margin-top: 16rpx; font-size: 24rpx; line-height: 1.6; }.cue text:first-child { color: var(--muted); }.warning { display: block; margin-top: 20rpx; padding: 18rpx; background: #f4f5f1; color: var(--muted); border-radius: 12rpx; font-size: 22rpx; line-height: 1.6; }.principle { margin: 28rpx 4rpx; color: var(--muted); font-size: 22rpx; line-height: 1.6; }.bottom-action { position: fixed; z-index: 5; bottom: 0; left: 0; right: 0; padding: 18rpx 36rpx calc(18rpx + env(safe-area-inset-bottom)); background: var(--paper); border-top: 2rpx solid var(--line); }
