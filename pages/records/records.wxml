<view class="page">
  <view class="nav-space" style="height: {{statusBarHeight}}px"></view>
  <view class="navbar"><text class="navbar-title">我的记录</text></view>
  <view class="stats card"><view><text class="stat-value">{{summary.streak || 0}}</text><text class="stat-label">连续天数</text></view><view><text class="stat-value">{{summary.total || 0}}</text><text class="stat-label">累计训练</text></view><view><text class="stat-value">{{summary.minutes || 0}}</text><text class="stat-label">累计分钟</text></view></view>
  <view class="calendar-card card"><view class="calendar-head"><button class="month-btn" data-offset="-1" bindtap="changeMonth">‹</button><text class="month-title">{{year}} 年 {{month}} 月</text><button class="month-btn" data-offset="1" bindtap="changeMonth">›</button></view><view class="weekday-row"><text wx:for="{{['一','二','三','四','五','六','日']}}" wx:key="*this">{{item}}</text></view><view class="calendar-grid"><view wx:for="{{calendar}}" wx:key="index" class="calendar-cell {{item.blank ? 'blank' : ''}}"><view wx:if="{{!item.blank}}" class="calendar-day {{item.checked ? 'checked' : ''}} {{item.today ? 'today' : ''}}">{{item.checked ? '✓' : item.day}}</view></view></view><view class="calendar-foot"><text><text class="legend-dot"></text> 已完成训练</text><text>本月 {{monthCount}} 次</text></view></view>
  <view class="history-head"><text>训练记录</text><text class="muted">本月 {{monthCount}} 次</text></view>
  <view wx:if="{{records.length}}" class="history-list"><view wx:for="{{records}}" wx:key="date" class="history-item"><view class="history-check">✓</view><view class="history-info"><text>{{item.title}}</text><text>{{item.label}} · {{item.exercises}} 个动作</text></view><text class="history-minutes">{{item.minutes}} 分钟</text></view></view>
  <view wx:else class="empty card"><text class="empty-title">还没有训练记录</text><text class="empty-copy">完成一次训练后会自动打卡。</text><button class="primary-btn" bindtap="goToday">去今日训练</button></view>
  <view class="safe-bottom"></view>
</view>
