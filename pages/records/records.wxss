.stats { display: flex; margin: 24rpx 0 24rpx; padding: 28rpx 0; }.stats > view { display: flex; flex-direction: column; align-items: center; width: 33.33%; border-right: 2rpx solid var(--line); }.stats > view:last-child { border: 0; }.stat-value { font-size: 42rpx; font-weight: 600; }.stat-label { color: var(--muted); font-size: 22rpx; margin-top: 10rpx; }.calendar-card { padding: 24rpx; }.calendar-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }.month-title { font-size: 29rpx; font-weight: 600; }.month-btn { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; color: var(--ink); font-size: 44rpx; background: transparent; }.weekday-row, .calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); }.weekday-row { color: var(--muted); font-size: 21rpx; text-align: center; margin-bottom: 12rpx; }.calendar-cell { height: 72rpx; display: flex; align-items: center; justify-content: center; }.calendar-day { width: 56rpx; height: 56rpx; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 24rpx; }.calendar-day.today { border: 2rpx solid var(--ink); }.calendar-day.checked { background: var(--ink); color: white; }.calendar-foot { display: flex; justify-content: space-between; border-top: 2rpx solid var(--line); margin-top: 16rpx; padding: 22rpx 4rpx 0; color: var(--muted); font-size: 21rpx; }.legend-dot { display: inline-block; width: 14rpx; height: 14rpx; border-radius: 50%; background: var(--ink); margin-right: 8rpx; }.history-head { display: flex; justify-content: space-between; align-items: center; margin: 36rpx 0 12rpx; }.history-head text:first-child { font-size: 29rpx; font-weight: 600; }.history-head text:last-child { font-size: 22rpx; }.history-item { display: flex; align-items: center; min-height: 116rpx; border-bottom: 2rpx solid var(--line); }.history-check { width: 48rpx; height: 48rpx; border-radius: 50%; background: #e5ebe6; display: flex; align-items: center; justify-content: center; margin-right: 20rpx; }.history-info { display: flex; flex: 1; flex-direction: column; font-size: 27rpx; font-weight: 600; }.history-info text:last-child { color: var(--muted); font-size: 21rpx; font-weight: 400; margin-top: 8rpx; }.history-minutes { font-size: 22rpx; color: var(--muted); }.empty { margin-top: 20rpx; padding: 36rpx 28rpx; display: flex; flex-direction: column; align-items: center; text-align: center; }.empty-title { font-size: 28rpx; font-weight: 600; }.empty-copy { color: var(--muted); font-size: 23rpx; margin: 14rpx 0 26rpx; }.empty .primary-btn { width: 100%; height: 88rpx; font-size: 27rpx; }
