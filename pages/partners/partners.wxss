.navbar { height: 88rpx; }.back-btn { width: 64rpx; height: 64rpx; background: transparent; color: var(--ink); font-size: 48rpx; text-align: left; }.nav-side { width: 64rpx; }.intro { margin: 36rpx 0 30rpx; }.intro-title { font-size: 38rpx; font-weight: 600; }.intro > text { display: block; margin-top: 14rpx; color: var(--muted); font-size: 23rpx; }.state-card { padding: 50rpx 28rpx; text-align: center; color: var(--muted); font-size: 25rpx; }.state-card button { margin-top: 22rpx; background: transparent; color: var(--ink); font-size: 25rpx; font-weight: 600; }.nudge-inbox { margin-bottom: 20rpx; padding: 24rpx; background: #fff8f3; border-color: #efded4; }.nudge-inbox-title { color: var(--orange); font-size: 24rpx; font-weight: 600; }.nudge-item { padding-top: 18rpx; margin-top: 18rpx; border-top: 2rpx solid #efded4; }.nudge-copy { display: flex; flex-direction: column; }.nudge-copy text:first-child { font-size: 27rpx; font-weight: 600; }.nudge-copy text:last-child { color: var(--muted); font-size: 21rpx; margin-top: 8rpx; }.nudge-actions { display: flex; justify-content: flex-end; align-items: center; gap: 16rpx; margin-top: 20rpx; }.rest-btn { height: 62rpx; padding: 0 16rpx; background: transparent; color: var(--muted); font-size: 22rpx; }.go-btn { height: 62rpx; padding: 0 22rpx; border-radius: 12rpx; background: var(--ink); color: #fff; font-size: 23rpx; }.shared-card { padding: 30rpx; border-radius: 22rpx; background: var(--ink); color: #fff; }.shared-card > text:first-child { color: #d4dfd9; font-size: 23rpx; }.shared-card > view { display: flex; align-items: baseline; gap: 12rpx; margin-top: 12rpx; }.shared-number { font-size: 64rpx; font-weight: 600; }.shared-card > view text:last-child { font-size: 25rpx; }.shared-caption { display: block; margin-top: 18rpx; color: #d4dfd9; font-size: 21rpx; line-height: 1.6; }.person-list { margin-top: 24rpx; }.person-card { padding: 26rpx; margin-bottom: 16rpx; }.self-card { background: #edf1ec; }.person-top { display: flex; align-items: center; justify-content: space-between; }.person-top > view { display: flex; flex-direction: column; }.person-name { font-size: 29rpx; font-weight: 600; }.person-count { font-size: 26rpx; font-weight: 600; }.today-status { color: var(--muted); font-size: 21rpx; margin-top: 8rpx; }.progress-dots { display: flex; gap: 12rpx; margin-top: 22rpx; }.progress-dot { width: 42rpx; height: 10rpx; border-radius: 5rpx; background: #e1e6df; }.progress-dot.done { background: var(--ink); }.partner-actions { display: flex; align-items: center; justify-content: space-between; margin-top: 26rpx; padding-top: 20rpx; border-top: 2rpx solid var(--line); }.remove-btn { background: transparent; color: var(--muted); font-size: 22rpx; }.cheer-btn { min-width: 176rpx; height: 64rpx; padding: 0 22rpx; border-radius: 12rpx; background: var(--ink); color: #fff; font-size: 23rpx; display: flex; align-items: center; justify-content: center; }.cheer-btn.cheered { background: #e4eae4; color: var(--muted); }.invite-more { display: block; margin: 26rpx auto; background: transparent; color: var(--ink); font-size: 25rpx; }.empty-card { padding: 42rpx 30rpx; text-align: center; }.empty-title { font-size: 31rpx; font-weight: 600; }.empty-copy { display: block; margin: 18rpx 0 30rpx; color: var(--muted); font-size: 24rpx; line-height: 1.7; }.empty-card .primary-btn { width: 100%; }.nickname-btn { display: block; margin: 28rpx auto 0; padding: 0 18rpx; background: transparent; color: var(--ink); font-size: 23rpx; }.privacy-note { margin: 18rpx 6rpx 0; color: var(--muted); font-size: 21rpx; line-height: 1.7; }.service-note { margin: 16rpx 6rpx 0; color: #8b918a; font-size: 20rpx; line-height: 1.7; }
