.workout-page { min-height: 100vh; padding-bottom: 150rpx; background: var(--paper); }.workout-nav { height: 88rpx; padding: 0 32rpx; display: flex; align-items: center; justify-content: space-between; font-size: 27rpx; font-weight: 600; }.close-btn { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; background: transparent; font-size: 42rpx; font-weight: 400; }.count { width: 64rpx; text-align: right; color: var(--muted); font-size: 23rpx; }.progress-track { height: 4rpx; background: #dfe4de; }.progress-value { height: 100%; background: var(--ink); transition: width .25s ease; }.workout-content { padding: 36rpx; }.workout-label { text-align: center; color: var(--muted); font-size: 23rpx; }.workout-title { margin-top: 18rpx; text-align: center; font-size: 44rpx; font-weight: 600; }.workout-reps { text-align: center; color: var(--muted); font-size: 27rpx; margin-top: 14rpx; }.timer-panel { width: 100%; min-height: 330rpx; margin: 30rpx 0 20rpx; padding: 30rpx 34rpx; border-radius: 28rpx; background: var(--ink); color: #fff; display: flex; flex-direction: column; justify-content: space-between; }.timer-status { display: flex; align-items: center; justify-content: space-between; }.timer-state { color: #d3e0d8; font-size: 24rpx; }.timer-tip { color: #a9bcb1; font-size: 22rpx; }.timer-value { display: flex; align-items: baseline; justify-content: center; gap: 14rpx; }.timer-number { font-size: 132rpx; font-weight: 600; line-height: 1.05; }.timer-unit { color: #c8d6cd; font-size: 27rpx; }.timer-progress { height: 8rpx; border-radius: 8rpx; background: rgba(255,255,255,.22); overflow: hidden; }.timer-progress-fill { height: 100%; background: #fff; transition: width .25s ease; }.timer-panel-hover { background: #1c3a32; }.timer-hint { display: block; text-align: center; color: var(--muted); font-size: 22rpx; }.form-guide { margin-top: 34rpx; padding: 26rpx; background: #fff; border: 2rpx solid var(--line); border-radius: 20rpx; }.guide-head { margin-bottom: 20rpx; font-size: 28rpx; font-weight: 600; }.guide-item { display: flex; gap: 16rpx; margin-top: 16rpx; font-size: 24rpx; line-height: 1.6; }.guide-index { color: var(--muted); }.caution { margin-top: 22rpx; padding-top: 20rpx; border-top: 2rpx solid var(--line); font-size: 22rpx; line-height: 1.6; color: var(--muted); }.workout-actions { position: fixed; z-index: 5; bottom: 0; left: 0; right: 0; display: flex; gap: 16rpx; padding: 18rpx 32rpx calc(18rpx + env(safe-area-inset-bottom)); background: var(--paper); border-top: 2rpx solid var(--line); }.prev-btn { width: 170rpx; height: 96rpx; display: flex; align-items: center; justify-content: center; border: 2rpx solid #cfd6cf; border-radius: 16rpx; color: var(--ink); background: transparent; font-size: 27rpx; }.prev-btn[disabled] { opacity: .35; }.next-btn { flex: 1; height: 96rpx; display: flex; align-items: center; justify-content: center; background: var(--ink); color: white; border-radius: 16rpx; font-size: 29rpx; font-weight: 600; }.finish-layer { position: fixed; z-index: 20; top: 0; right: 0; bottom: 0; left: 0; background: var(--paper); color: var(--ink); }.finish-content { padding: 150rpx 44rpx 50rpx; display: flex; flex-direction: column; align-items: center; text-align: center; }.finish-badge { width: 88rpx; height: 88rpx; margin-bottom: 34rpx; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--ink); color: #fff; font-size: 44rpx; }.finish-title { font-size: 42rpx; font-weight: 600; }.finish-copy { color: var(--muted); margin-top: 18rpx; font-size: 25rpx; }.finish-stats { display: flex; width: 100%; margin: 56rpx 0; padding: 30rpx 0; background: #fff; border: 2rpx solid var(--line); border-radius: 20rpx; }.finish-stats view { width: 33.33%; display: flex; flex-direction: column; }.finish-stats view text:first-child { font-size: 42rpx; font-weight: 600; }.finish-stats view text:last-child { color: var(--muted); font-size: 21rpx; margin-top: 10rpx; }.finish-content .primary-btn { width: 100%; }.records-link { margin-top: 28rpx; background: transparent; color: var(--ink); font-size: 25rpx; }
