.member-page { min-height: 100vh; background: var(--paper); }.member-nav { height: 88rpx; padding: 0 32rpx; display: flex; align-items: center; justify-content: space-between; font-size: 30rpx; font-weight: 600; }.member-nav button { width: 64rpx; height: 64rpx; background: transparent; font-size: 48rpx; text-align: left; }.member-nav > text:last-child { width: 64rpx; }.member-header { padding: 38rpx 36rpx 28rpx; }.member-heading { font-size: 38rpx; font-weight: 600; }.member-header-copy { display: block; color: var(--muted); font-size: 24rpx; margin-top: 16rpx; }.checkout { padding: 10rpx 36rpx calc(30rpx + env(safe-area-inset-bottom)); }.plan-options { display: flex; flex-direction: column; gap: 16rpx; }.plan-option { position: relative; display: flex; align-items: center; min-height: 124rpx; padding: 24rpx; border: 2rpx solid var(--line); border-radius: 18rpx; background: #fff; }.plan-option.selected { border: 3rpx solid var(--ink); padding: 23rpx; }.plan-badge { position: absolute; top: -12rpx; right: 20rpx; padding: 3rpx 12rpx; border-radius: 6rpx; background: #e5ebe6; color: var(--ink); font-size: 18rpx; }.radio { width: 36rpx; height: 36rpx; border: 2rpx solid #b5bcb6; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-right: 20rpx; }.selected .radio { border-color: var(--ink); }.selected .radio view { width: 20rpx; height: 20rpx; border-radius: 50%; background: var(--ink); }.plan-copy { display: flex; flex: 1; flex-direction: column; }.plan-copy text:first-child { font-size: 28rpx; font-weight: 600; }.plan-copy text:last-child { color: var(--muted); font-size: 21rpx; margin-top: 10rpx; }.price { display: flex; align-items: baseline; color: var(--ink); }.price text:first-child { font-size: 23rpx; }.price text:last-child { font-size: 42rpx; font-weight: 600; }.renew-note { margin: 22rpx 4rpx; color: var(--muted); font-size: 22rpx; line-height: 1.6; }.agreement { display: flex; align-items: center; flex-wrap: wrap; margin: 28rpx 0; font-size: 21rpx; color: var(--muted); }.checkbox { width: 32rpx; height: 32rpx; border: 2rpx solid #aeb5ae; border-radius: 6rpx; margin-right: 12rpx; display: flex; align-items: center; justify-content: center; color: white; font-size: 20rpx; }.checkbox.checked { background: var(--ink); border-color: var(--ink); }.agreement button { background: transparent; color: var(--ink); font-size: 21rpx; }.pay-btn { height: 100rpx; padding: 0 30rpx; border-radius: 18rpx; background: var(--ink); color: white; display: flex; align-items: center; justify-content: space-between; font-size: 30rpx; font-weight: 600; }.pay-btn.disabled { opacity: .6; }.secure-note { text-align: center; margin-top: 22rpx; color: var(--muted); font-size: 20rpx; }
